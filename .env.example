# Add these after you receive credentials. Keep them on the server; never put them in VITE_* variables.
# WeatherAPI.com free key: https://www.weatherapi.com/signup.aspx (required for public deployment)
WEATHERAPI_KEY=

# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Current Gemini model with a free tier (limits and availability can change).
GEMINI_MODEL=gemini-3.5-flash-lite

# data.gov.in key: https://data.gov.in/user/register
DATA_GOV_API_KEY=

# Optional: app display name
APP_NAME=KhetiQ
PORT=8787
